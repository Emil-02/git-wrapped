# Server-side token used to read public GitHub data (required).
# Create a fine-grained or classic token with NO scopes: https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Optional: "Sign in with GitHub" to include private contributions ---
# Create an OAuth App at https://github.com/settings/developers
# Callback URL: https://<your-domain>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random string, at least 32 characters. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Defaults to "read:user repo" (needed to read private repo details).
# Use "read:user" for a less scary consent screen (private contribution counts only).
# GITHUB_OAUTH_SCOPE=read:user repo

# --- Optional ---
# Public URL used for absolute OG image links. Auto-detected on Vercel.
# NEXT_PUBLIC_SITE_URL=https://git-wrapped.example.com
# Link used by the "Star on GitHub" buttons.
# NEXT_PUBLIC_REPO_URL=https://github.com/Emil-02/git-wrapped
